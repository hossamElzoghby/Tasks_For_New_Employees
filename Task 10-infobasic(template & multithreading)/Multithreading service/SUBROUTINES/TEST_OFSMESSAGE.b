PROGRAM TEST_OFSMESSAGE
    $INSERT I_COMMON
    $INSERT I_EQUATE
    
    Y.MESSAGE='FT22109ZDCNC/BULK262384866167926.13/1,TRANSACTION.TYPE:1:1=AC,DEBIT.ACCT.NO:1:1=100005,CURRENCY.MKT.DR:1:1=1,DEBIT.CURRENCY:1:1=EUR,DEBIT.AMOUNT:1:1=10.00,DEBIT.VALUE.DATE:1:1=20220419,CREDIT.ACCT.NO'
    Y.MSG.INFO   = FIELD(Y.MESSAGE, ',', 1)
    Y.OFS.STATUS = FIELD(Y.MSG.INFO, '/', 3)

    IF Y.OFS.STATUS EQ '1' THEN
        Y.STATUS = 'SUCCESS'
        PRINT Y.STATUS
    END ELSE
        Y.STATUS = 'FAILED'
        PRINT Y.STATUS
    END
END
